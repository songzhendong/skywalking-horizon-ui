          "inflight",
          "queue",
          "block"
        ]
      },
      {
        "id": "remote_latency",
        "title": "Cluster Remote Latency (ms)",
        "tip": "Milliseconds. Out (self=N): worst peer p50/p99 (max) and top-5 dest by p99. In: per-message p99. Self fan-out omitted.",
        "expressionLabels": [
          "out worst",
          "out by dest",
          "in p99"
        ]
      },
      {
        "id": "alarm_delivery",
